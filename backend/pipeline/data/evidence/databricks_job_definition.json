{
  "deployment": {
    "kind": "BUNDLE",
    "metadata_file_path": "/Users/<user>/.bundle/churn-spark/free/state/metadata.json"
  },
  "description": "Bronze -> data quality -> Silver -> Gold -> reconciliation -> star schema -> train -> score, same src/ modules as the laptop, writing Unity Catalog tables in workspace.churn_spark.",
  "edit_mode": "UI_LOCKED",
  "email_notifications": {},
  "environments": [
    {
      "environment_key": "serverless_v4",
      "spec": {
        "environment_version": "4"
      }
    }
  ],
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "name": "churn-spark-pipeline",
  "queue": {
    "enabled": true
  },
  "schedule": {
    "pause_status": "UNPAUSED",
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata"
  },
  "tasks": [
    {
      "disabled": false,
      "email_notifications": {},
      "environment_key": "serverless_v4",
      "run_if": "ALL_SUCCESS",
      "spark_python_task": {
        "parameters": [
          "--catalog",
          "workspace",
          "--schema",
          "churn_spark",
          "--volume",
          "files",
          "--code-root",
          "/Users/<user>/.bundle/churn-spark/free/files"
        ],
        "python_file": "/Users/<user>/.bundle/churn-spark/free/files/jobs/run_pipeline.py"
      },
      "task_key": "run_pipeline",
      "timeout_seconds": 0
    }
  ],
  "timeout_seconds": 3600,
  "webhook_notifications": {}
}