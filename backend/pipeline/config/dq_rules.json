  {
    "id": "dq10",
    "description": "TotalCharges blank on a row with tenure = 0",
    "type": "expression",
    "columns": [
      "TotalCharges"
    ],
    "action": "fix",
    "max_failing_rate": 0.0,
    "failing_condition": "trim(TotalCharges) = '' AND tenure = '0'"
  },
  {
    "id": "dq11",
    "description": "TotalCharges blank on a row with tenure > 0",
    "type": "expression",
    "columns": [
      "TotalCharges"
    ],
    "action": "fail",
    "max_failing_rate": 0.0,
    "failing_condition": "trim(TotalCharges) = '' AND tenure <> '0'"
  },
  {
    "id": "dq11b",
    "description": "TotalCharges non-blank but not numeric",
    "type": "expression",
    "columns": [
      "TotalCharges"
    ],
    "action": "fail",
    "max_failing_rate": 0.0,
    "failing_condition": "trim(TotalCharges) <> '' AND try_cast(trim(TotalCharges) AS DOUBLE) IS NULL"
  },
  {
