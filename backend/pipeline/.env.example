SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=churn_db
# integrated = Windows Authentication (default, no password); sql = SQL login (needs the two lines below)
SQLSERVER_AUTH=integrated
# SQLSERVER_USER=churn_etl
# SQLSERVER_PASSWORD=
# Databricks: put DATABRICKS_HOST and DATABRICKS_TOKEN in .env.databricks instead (CLI only;
# kept out of this file so the worker container never receives the token)
